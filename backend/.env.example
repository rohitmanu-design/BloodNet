# ===================================================
# BloodNet+ Backend Environment Configuration
# ===================================================

# Server Runtime
NODE_ENV=production
PORT=5000

# Database Configuration (MongoDB Atlas connection string)
# Replace <username>, <password>, and <cluster> with your Atlas cluster details
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/bloodnet?retryWrites=true&w=majority

# Authentication & Security
# Generate a strong 32+ character random string for production
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=30d
BCRYPT_ROUNDS=10

# CORS & Client Integration (Set to your live frontend URL)
CLIENT_URL=https://bloodnet-plus-eight.vercel.app
FRONTEND_URL=https://bloodnet-plus-eight.vercel.app
CORS_ORIGIN=https://bloodnet-plus-eight.vercel.app
CORS_CREDENTIALS=true

# Donor Screening Rules (Configurable Defaults)
DONOR_MIN_WEIGHT_KG=50
DONOR_MIN_HEMOGLOBIN_GDL=13.0
DONOR_MIN_AGE_YEARS=18
DONOR_MAX_AGE_YEARS=65

# ---------------------------------------------------
# Email Delivery Service (SMTP via Nodemailer)
# Required for sending email OTP codes and password reset links
# ---------------------------------------------------
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=your_sendgrid_api_key_or_smtp_password
# EMAIL_FROM="BloodNet+ Security" <noreply@bloodnet.org>

# ---------------------------------------------------
# SMS Delivery Service (Twilio)
# Required for sending 4-digit phone verification OTP codes
# ---------------------------------------------------
# TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890
# TWILIO_MESSAGING_SERVICE_SID=MGXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX (Optional alternative to TWILIO_PHONE_NUMBER)

# File Upload Settings (Optional)
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads
